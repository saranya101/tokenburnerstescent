DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"
# Explicitly allow idempotent startup migrations only for a verified isolated synthetic Railway DB.
PARLANCE_SYNTHETIC_DB_MIGRATIONS_ALLOWED="false"
# Durable synthetic bank remains disabled until its migration and financial-write
# tests are approved for the verified isolated database. Both flags are required.
PARLANCE_BANK_DATABASE_SNAPSHOT="true"
PARLANCE_BANK_DURABLE_EXECUTION="false"
PARLANCE_ISOLATED_SYNTHETIC_EXECUTION_APPROVED="false"
# Dedicated disposable database only. Integration tests never fall back to DATABASE_URL.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/parlance_test"
# dev:safe derives the mock-bank's next state version and complete state from the latest test snapshot.
REDIS_URL="redis://localhost:6379"
TOKENHUB_API_KEY=""
TOKENHUB_BASE_URL="https://tokenhub-intl.tencentcloudmaas.com/v1"
TOKENHUB_MODEL="hy3"
TOKENHUB_THINKING="disabled"
COMPILER_URL="http://localhost:8001"
MOCK_BANK_URL="http://localhost:4002"
# Server-side customer identity supplied by the trusted web session/proxy in local development.
PARLANCE_CUSTOMER_USER_ID=""
# Shared only between the web BFF and API. Never expose through NEXT_PUBLIC_*.
PARLANCE_INTERNAL_API_TOKEN=""
# Separate server/operator credential for ops, recovery workers, and demo controls.
PARLANCE_OPS_API_TOKEN=""
# Human-facing credential used only to establish a short-lived web operator session.
PARLANCE_OPERATOR_ACCESS_TOKEN=""
# Web-server-only HMAC key for operator session cookies. Never expose to browser code.
PARLANCE_OPERATOR_SESSION_SECRET=""
# Trusted API and web-server diagnostics -> mock-bank normal banking API.
PARLANCE_BANK_API_TOKEN=""
PARLANCE_WEBAUTHN_RP_ID="localhost"
PARLANCE_WEBAUTHN_ORIGIN="http://localhost:3000"
# First-party email/password authentication. Generate a unique random secret (at least 32 bytes).
# Server only: never embed this signing secret in the website or Android APK.
PARLANCE_AUTH_JWT_SECRET=""
PARLANCE_AUTH_JWT_ISSUER="parlance"
PARLANCE_WEB_PUBLIC_ORIGIN="https://tokenburnerstescent-production.up.railway.app"
# Android needs only the public HTTPS website origin, with no identity provider settings.
PARLANCE_MOBILE_PUBLIC_API_URL=""
# Keep all public banking and operator routes closed until web authentication is verified.
PARLANCE_PUBLIC_SAFE_MODE="true"
# In public safe mode, permit only /api/mobile/* after signing secret, DB, and API configuration is present.
PARLANCE_PUBLIC_MOBILE_ENABLED="false"
# Open only verified web sign-in and pre-authorization customer API routes.
# Requires first-party credential tables and signing secret.
PARLANCE_PUBLIC_WEB_ENABLED="false"
# Allow authenticated browser passkey enrollment only. Approval and execution remain closed in public safe mode.
PARLANCE_PUBLIC_PASSKEY_ENROLLMENT_ENABLED="false"
# Separate final gate. Requires enrolled passkeys, approved isolated durable bank,
# browser ceremony verification and API execution checks before activation.
PARLANCE_PUBLIC_PASSKEY_EXECUTION_ENABLED="false"
# Only on a separate public mobile gateway deployment. Reject every non-mobile route.
PARLANCE_MOBILE_GATEWAY_ONLY="false"
# Development/demo enrollment only. Keep disabled outside the local hackathon flow.
PARLANCE_DEMO_WEBAUTHN_ENROLLMENT="false"
PARLANCE_DEMO_USER_ID=""
# Fault-injection and mock-bank admin routes remain unavailable unless explicitly enabled.
PARLANCE_DEMO_MODE="false"
OTEL_EXPORTER_OTLP_ENDPOINT=""

DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"
# Dedicated disposable database only. Integration tests never fall back to DATABASE_URL.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/parlance_test"
# dev:safe derives the mock-bank's next state version and complete state from the latest test snapshot.
REDIS_URL="redis://localhost:6379"
TOKENHUB_API_KEY=""
TOKENHUB_BASE_URL="https://tokenhub-intl.tencentcloudmaas.com/v1"
TOKENHUB_MODEL="hy3"
TOKENHUB_THINKING="disabled"
COMPILER_URL="http://localhost:8001"
MOCK_BANK_URL="http://localhost:4002"
# Server-side customer identity supplied by the trusted web session/proxy in local development.
PARLANCE_CUSTOMER_USER_ID=""
# Shared only between the web BFF and API. Never expose through NEXT_PUBLIC_*.
PARLANCE_INTERNAL_API_TOKEN=""
# Separate server/operator credential for ops, recovery workers, and demo controls.
PARLANCE_OPS_API_TOKEN=""
# Human-facing credential used only to establish a short-lived web operator session.
PARLANCE_OPERATOR_ACCESS_TOKEN=""
# Web-server-only HMAC key for operator session cookies. Never expose to browser code.
PARLANCE_OPERATOR_SESSION_SECRET=""
# Trusted API and web-server diagnostics -> mock-bank normal banking API.
PARLANCE_BANK_API_TOKEN=""
PARLANCE_WEBAUTHN_RP_ID="localhost"
PARLANCE_WEBAUTHN_ORIGIN="http://localhost:3000"
# Mobile public app configuration and server-verified OIDC access tokens.
PARLANCE_MOBILE_PUBLIC_API_URL=""
PARLANCE_MOBILE_PUBLIC_OIDC_ISSUER=""
PARLANCE_MOBILE_PUBLIC_OIDC_CLIENT_ID=""
PARLANCE_MOBILE_OIDC_ISSUER=""
PARLANCE_MOBILE_OIDC_AUDIENCE=""
PARLANCE_MOBILE_OIDC_JWKS_URI=""
# Development/demo enrollment only. Keep disabled outside the local hackathon flow.
PARLANCE_DEMO_WEBAUTHN_ENROLLMENT="false"
PARLANCE_DEMO_USER_ID=""
# Fault-injection and mock-bank admin routes remain unavailable unless explicitly enabled.
PARLANCE_DEMO_MODE="false"
OTEL_EXPORTER_OTLP_ENDPOINT=""

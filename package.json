{
  "name": "parlance",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/turbo/bin/turbo dev --env-mode=loose",
    "db:setup": "node --env-file=.env packages/db/node_modules/prisma/build/index.js migrate deploy --schema packages/db/prisma/schema.prisma && pnpm db:seed",
    "db:seed": "node --env-file=.env packages/db/prisma/seed.mjs",
    "build": "turbo build",
    "lint": "turbo lint && pnpm compiler:lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test && pnpm compiler:test",
    "compiler:dev": "set -a; . ./.env; set +a; cd services/compiler && ./.venv/bin/uvicorn app.main:app --reload --port 8001",
    "compiler:lint": "cd services/compiler && ./.venv/bin/ruff check . && ./.venv/bin/ruff format --check .",
    "compiler:test": "cd services/compiler && ./.venv/bin/pytest",
    "eval:intent:live": "pnpm --filter @parlance/intent-engine exec tsx ../../evaluation/intent-live/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  }
}
